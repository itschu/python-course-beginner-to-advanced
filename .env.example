# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.

# --- Accounts and cloud progress sync (optional) ---
# Without these, the site works and progress is saved in the browser.
# Postgres connection string. Vercel's Neon integration sets this for you.
DATABASE_URL=
# Random secret for signing sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the site, e.g. https://your-app.vercel.app (http://localhost:3000 locally).
BETTER_AUTH_URL=http://localhost:3000

# --- "Continue with GitHub" (optional) ---
# Create an OAuth app at https://github.com/settings/developers
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Optional overrides ---
# NEXT_PUBLIC_PYODIDE_INDEX_URL=https://cdn.jsdelivr.net/pyodide/v314.0.7/full/
# NEXT_PUBLIC_REPO=itschu/python-course-beginner-to-advanced
# NEXT_PUBLIC_REPO_BRANCH=main
